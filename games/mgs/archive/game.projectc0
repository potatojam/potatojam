[project]
title = Mobile Gamer Simulator
version = 1

[bootstrap]
main_collection = /collections/_loader/_loader.collectionc
render = /modules/render/custom.renderc

[input]
game_binding = /modules/input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1440
height = 1080
high_dpi = 1

[script]
shared_state = 1

[physics]
scale = 0.02
max_collisions = 256
debug = 0

[graphics]
texture_profiles = /modules/render/custom.texture_profiles

[collection_proxy]
max_count = 32

[native_extension]
app_manifest = /release.appmanifest

