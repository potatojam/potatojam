[project]
title = Bring me Cakes
version = 0.81d
custom_resources = levels/
compress_archive = 1
write_log = 0
dependencies = https://github.com/britzl/defold-googleanalytics/archive/master.zip,https://github.com/AGulev/ag_window/archive/master.zip

[bootstrap]
main_collection = /collections/loader/init.collectionc
render = /render/custom.renderc

[input]
game_binding = /gamelogic/input/game.input_bindingc

[display]
width = 1536
height = 2048
display_profiles = /builtins/render/default.display_profilesc
fullscreen = 0
dynamic_orientation = 0
high_dpi = 1

[physics]
scale = 0.02
debug = 0
gravity_y = 0
world_count = 6

[script]
shared_state = 1

[html5]
splash_image = /otherArt/splash/1536_2048.png

[tracking]
app_id = 2D15E06F6242B7B7

[iap]
auto_finish_transactions = 0

[sprite]
max_count = 512

[graphics]
default_texture_mag_filter = linear
default_texture_min_filter = linear
texture_profiles = /render/custom.texture_profiles

[ios]
app_icon_120x120 = /otherArt/icons/120.png
app_icon_180x180 = /otherArt/icons/180.png
app_icon_76x76 = /otherArt/icons/76.png
app_icon_152x152 = /otherArt/icons/152.png
app_icon_57x57 = /otherArt/icons/57.png
app_icon_114x114 = /otherArt/icons/114.png
app_icon_72x72 = /otherArt/icons/72.png
app_icon_144x144 = /otherArt/icons/144.png
app_icon_167x167 = /otherArt/icons/167.png
bundle_identifier = bring-me-cakes.com
launch_image_320x480 = /otherArt/splash/320_480.png
launch_image_640x960 = /otherArt/splash/640_960.png
launch_image_640x1136 = /otherArt/splash/640_1136.png
launch_image_750x1334 = /otherArt/splash/750_1334.png
launch_image_768x1024 = /otherArt/splash/768_1024.png
launch_image_1536x2048 = /otherArt/splash/1536_2048.png
launch_image_1242x2208 = /otherArt/splash/1242_2208.png
launch_image_2048x2732 = /otherArt/splash/2048_2732.png

[android]
app_icon_36x36 = /otherArt/icons/36.png
app_icon_48x48 = /otherArt/icons/48.png
app_icon_72x72 = /otherArt/icons/72.png
app_icon_96x96 = /otherArt/icons/96.png
app_icon_144x144 = /otherArt/icons/144.png
app_icon_192x192 = /otherArt/icons/192.png
package = com.bringmecakes
version_code = 11
immersive_mode = 1

[osx]
app_icon = /otherArt/icons/192.png

[windows]
app_icon = /otherArt/icons/192.png

[particle_fx]
max_particle_count = 2048
max_count = 128

[resource]
max_resources = 2048

[collection]
max_instances = 1536

[googleanalytics]
tracking_id = UA-89195215-1

[facebook]
